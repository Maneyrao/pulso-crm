<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <ProjectReference Include="..\Pulso.Agent.Core\Pulso.Agent.Core.csproj" />
    <ProjectReference Include="..\Pulso.Agent.Protocol\Pulso.Agent.Protocol.csproj" />
    <ProjectReference Include="..\Pulso.Agent.Sensors\Pulso.Agent.Sensors.csproj" />
    <ProjectReference Include="..\Pulso.Agent.Backend\Pulso.Agent.Backend.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
