<Application x:Class="ElTemplo.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B0A09" />
        <SolidColorBrush x:Key="PanelBackground" Color="#151311" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3D372F" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4EFE7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B7ADA0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C39A5B" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#17120C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
