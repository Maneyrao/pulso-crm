<Window x:Class="ElTemplo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="El Templo CRM"
        Width="1360"
        Height="860"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/el-templo-logo.png"
        Background="{StaticResource WindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="46" Height="46" Source="Assets/el-templo-logo.png" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="EL TEMPLO" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Gestión y acceso" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#D7A13A" Margin="0,0,8,0" />
                    <TextBlock x:Name="ConnectionLabel" Text="Conectando" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

            <Grid x:Name="LoadingPanel" Background="{StaticResource WindowBackground}">
                <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="120" Height="120" Source="Assets/el-templo-logo.png" Stretch="Uniform" />
                    <TextBlock Margin="0,24,0,8" Text="Abriendo El Templo CRM" Foreground="{StaticResource TextBrush}" FontSize="26" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="Estamos conectando esta computadora con tu información." Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar Margin="0,28,0,0" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#27221D" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ErrorPanel" Background="{StaticResource WindowBackground}" Visibility="Collapsed">
                <Border Width="520" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="No pudimos abrir el CRM" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock x:Name="ErrorMessage" Margin="0,14,0,24" Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Reintentar" Click="Retry_Click" HorizontalAlignment="Center" MinWidth="150" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
