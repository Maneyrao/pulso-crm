<Window x:Class="ElTemplo.Agent.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar El Templo Huella"
        Width="940"
        Height="660"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="Assets/el-templo-logo.png"
        Background="{StaticResource WindowBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="34,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Width="58" Height="58" Source="Assets/el-templo-logo.png" Stretch="Uniform" />
                    <StackPanel Margin="12,7,0,0">
                        <TextBlock Text="EL TEMPLO" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Conexión del lector" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,56,0,0">
                    <TextBlock x:Name="Step0" Text="1  Bienvenida" Margin="0,0,0,22" FontSize="14" />
                    <TextBlock x:Name="Step1" Text="2  Comprobar PC" Margin="0,0,0,22" FontSize="14" />
                    <TextBlock x:Name="Step2" Text="3  Conectar CRM" Margin="0,0,0,22" FontSize="14" />
                    <TextBlock x:Name="Step3" Text="4  Elegir sede" Margin="0,0,0,22" FontSize="14" />
                    <TextBlock x:Name="Step4" Text="5  Instalar" Margin="0,0,0,22" FontSize="14" />
                    <TextBlock x:Name="Step5" Text="6  Probar lector" Margin="0,0,0,22" FontSize="14" />
                    <TextBlock x:Name="Step6" Text="7  Listo" FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Versión 0.3.0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Text="La huella nunca se guarda como imagen." Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="54,42,54,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel x:Name="WelcomePage" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Conectá el lector al CRM web" />
                    <TextBlock Style="{StaticResource PageCopy}" Margin="0,18,0,0" Text="Vamos a vincular esta computadora con tu sede y dejar preparado el lector de huellas. El CRM seguirá funcionando desde el navegador." />
                    <Border Margin="0,32,0,0" Padding="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Antes de empezar" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="Conectá el lector por USB y tené a mano tu email y contraseña del CRM." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ChecksPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Comprobamos esta computadora" />
                    <TextBlock Style="{StaticResource PageCopy}" Margin="0,12,0,22" Text="Esto tarda unos segundos. Te indicamos claramente si falta algo." />
                    <ProgressBar x:Name="ChecksProgress" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#28221C" />
                    <StackPanel x:Name="ChecksList" Margin="0,18,0,0" />
                    <TextBlock x:Name="ChecksError" Margin="0,16,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="LoginPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Ingresá a El Templo CRM" />
                    <TextBlock Style="{StaticResource PageCopy}" Margin="0,12,0,25" Text="Usamos tu cuenta solo para vincular esta computadora. La contraseña no se guarda." />
                    <TextBlock Text="Email" Margin="0,0,0,7" FontWeight="SemiBold" />
                    <TextBox x:Name="EmailInput" MaxWidth="460" HorizontalAlignment="Stretch" AutomationProperties.Name="Email del CRM" />
                    <TextBlock Text="Contraseña" Margin="0,18,0,7" FontWeight="SemiBold" />
                    <PasswordBox x:Name="PasswordInput" MaxWidth="460" HorizontalAlignment="Stretch" AutomationProperties.Name="Contraseña del CRM" />
                    <TextBlock x:Name="LoginError" Margin="0,14,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="BranchPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="¿Dónde se usará esta PC?" />
                    <TextBlock x:Name="GymNameText" Style="{StaticResource PageCopy}" Margin="0,12,0,24" />
                    <TextBlock Text="Sede" Margin="0,0,0,7" FontWeight="SemiBold" />
                    <ComboBox x:Name="BranchInput"
                              MaxWidth="460"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              AutomationProperties.Name="Sede del lector" />
                    <TextBlock x:Name="BranchError" Margin="0,14,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="InstallPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Estamos conectando el lector" />
                    <TextBlock Style="{StaticResource PageCopy}" Margin="0,12,0,32" Text="Podés mirar el avance. No desconectes el lector ni apagues la computadora." />
                    <TextBlock x:Name="InstallMessage" Text="Preparando la instalación..." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar x:Name="InstallProgress" Margin="0,18,0,0" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#28221C" />
                    <TextBlock x:Name="InstallPercent" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" Text="0%" />
                    <Border x:Name="InstallErrorPanel" Visibility="Collapsed" Margin="0,24,0,0" Padding="16" Background="#251410" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="InstallError" Foreground="#F3B0A7" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ReaderPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="64" Height="64" HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="32">
                        <TextBlock x:Name="ReaderSymbol" Text="✓" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                    <TextBlock x:Name="ReaderTitle" Style="{StaticResource PageTitle}" Margin="0,22,0,0" Text="Lector encontrado" />
                    <TextBlock x:Name="ReaderMessage" Style="{StaticResource PageCopy}" Margin="0,12,0,0" />
                    <StackPanel x:Name="ReaderHelp" Visibility="Collapsed" Margin="0,22,0,0">
                        <TextBlock Foreground="{StaticResource WarningBrush}" Text="1. Dejá el lector conectado.  2. Instalá el controlador oficial.  3. Volvé y pulsá Probar otra vez." TextWrapping="Wrap" LineHeight="23" />
                        <Button x:Name="DriverButton" Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Abrir controlador oficial" Click="Driver_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="FinishPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="70" Height="70" HorizontalAlignment="Left" Background="#173321" CornerRadius="35">
                        <TextBlock Text="✓" FontSize="35" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0,24,0,0" Text="El lector está listo" />
                    <TextBlock x:Name="FinishMessage" Style="{StaticResource PageCopy}" Margin="0,12,0,0" Text="El agente se iniciará automáticamente con Windows. Ahora abriremos el CRM en tu navegador." />
                    <TextBlock Margin="0,22,0,0" Foreground="{StaticResource MutedBrush}" Text="Próximo paso: abrí un socio, registrá su consentimiento y enrolá la huella." TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Atrás" Click="Back_Click" Visibility="Collapsed" />
                <Button x:Name="RetryButton" Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource SecondaryButton}" Content="Probar otra vez" Click="Retry_Click" Visibility="Collapsed" />
                <Button x:Name="PrimaryButton" Grid.Column="2" Content="Comenzar" Click="Primary_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
