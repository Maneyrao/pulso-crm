<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ElTemploCRM-Setup</AssemblyName>
    <RootNamespace>ElTemplo.Agent.Setup</RootNamespace>
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ElTemplo.Setup.Core/ElTemplo.Setup.Core.csproj" />
    <ProjectReference Include="../../src/Pulso.Agent.Backend/Pulso.Agent.Backend.csproj" />
    <ProjectReference Include="../../src/Pulso.Agent.Sensors/Pulso.Agent.Sensors.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/el-templo-logo.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(AgentPayloadPath)' != ''">
    <EmbeddedResource Include="$(AgentPayloadPath)" LogicalName="ElTemploAgent.exe" />
  </ItemGroup>
  <ItemGroup Condition="'$(DesktopPayloadPath)' != ''">
    <EmbeddedResource Include="$(DesktopPayloadPath)" LogicalName="ElTemploCRM.exe" />
  </ItemGroup>
</Project>
